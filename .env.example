NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://rrpl:rrpl_dev_password@localhost:5432/rrpl_erp?schema=public
POSTGRES_DB=rrpl_erp
POSTGRES_USER=rrpl
POSTGRES_PASSWORD=rrpl_dev_password
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-development-secret
