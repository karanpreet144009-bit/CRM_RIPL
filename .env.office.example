# Copy this file to .env only when deploying with docker-compose.production.yml.
# Generate your own long random database/JWT secrets; do not use these example values.
NODE_ENV=production
POSTGRES_DB=rrpl_erp
POSTGRES_USER=rrpl
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://rrpl:replace-with-a-long-random-password@postgres:5432/rrpl_erp?schema=public
API_PORT=4000
WEB_ORIGIN=https://erp.rrpl.local
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=rrpl-housing-group-erp
JWT_AUDIENCE=rrpl-office-users
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
